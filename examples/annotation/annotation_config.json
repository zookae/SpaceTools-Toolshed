{
  "roborefer": {
    "num_actors": 1,
    "resources": {
      "num_gpus": 1
    },
    "conda_env": "tool_roborefer",
    "args": {
      "model_path": "checkpoints/RoboRefer-8B-SFT",
      "no_output_image": false,
      "no_output_vars": false,
      "exclude_methods": ["general_query"],
      "exclude_behavior": "error"
    }
  },
  "depth_estimator": {
    "num_actors": 1,
    "resources": {
      "num_gpus": 0.3
    },
    "conda_env": "tool_depth",
    "timeout": 600,
    "args": {
      "checkpoint_path": "checkpoints/depth_pro.pt",
      "no_output_image": false,
      "no_output_vars": false
    }
  },
  "sam2": {
    "num_actors": 1,
    "resources": {
      "num_gpus": 0.3
    },
    "conda_env": "tool_sam2",
    "timeout": 600,
    "args": {
      "no_output_image": false,
      "no_output_vars": false
    }
  },
  "bounding_box": {
    "num_actors": 1,
    "resources": {
      "num_gpus": 0
    },
    "conda_env": "tool_bbox",
    "timeout": 600,
    "args": {
      "no_output_image": false,
      "no_output_vars": false
    }
  },
  "save_data": {
    "import_path": "examples.annotation.tool_save_data:SaveDataTool",
    "num_actors": 1,
    "resources": {
      "num_cpus": 1,
      "num_gpus": 0
    },
    "conda_env": "toolshed",
    "args": {
      "save_path": "outputs/annotation",
      "no_output_image": false,
      "no_output_vars": false
    }
  }
}
